# Required only for a credentialed LIVE AssemblyAI run.
ASSEMBLYAI_API_KEY=


# Optional for natural ERRATA guidance. If already stored as a persistent
# Windows User/Machine variable, ERRATA can reuse it without copying it here.
AI33_API_KEY=
AI33_BASE_URL=https://api.ai33.pro

# Non-secret voice configuration.
AI33_ERRATA_VOICE_ID=elevenlabs_yG30oCchdy9JCUsKqYfV
AI33_ERRATA_VOICE_LABEL=Zach / George V2
AI33_ERRATA_SPEED=0.98


# Required by the public FastAPI/Vercel signed-session state model.
# Generate a strong random value; never commit the real value.
ERRATA_SESSION_HMAC_KEY=


# Optional — bounded ERRATA phone transport (Twilio Voice + Media Streams).
# Configure these only in server-side environments. Never expose them to browser code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SMS_FROM=

# Canonical public origin used by Twilio signature validation and callback construction.
# Example after production promotion:
# ERRATA_PUBLIC_ORIGIN=https://errata-beige.vercel.app
ERRATA_PUBLIC_ORIGIN=


# Optional — free Bandwidth Build phone transport.
# Bandwidth Build provides a US number + trial credits without a credit card.
# Keep all real values server-side only.
BANDWIDTH_ACCOUNT_ID=
BANDWIDTH_CLIENT_ID=
BANDWIDTH_CLIENT_SECRET=
BANDWIDTH_WEBHOOK_USERNAME=
BANDWIDTH_WEBHOOK_PASSWORD=
BANDWIDTH_STREAM_USERNAME=
BANDWIDTH_STREAM_PASSWORD=
BANDWIDTH_PHONE_HMAC_KEY=
BANDWIDTH_PHONE_NUMBER=

# ERRATA_PUBLIC_ORIGIN is reused for Bandwidth webhook/gather/stream URLs.
